# Environment: dev|prod
ENV=dev
# CONFIG_FILE=configs/config.dev.yaml

# HTTP server
SERVER_HOST=0.0.0.0
SERVER_PORT=8080
SERVER_READ_TIMEOUT=30s
SERVER_WRITE_TIMEOUT=30s
# SERVER_PPROF_ADDRESS=127.0.0.1:6060
SERVER_MAX_UPLOAD_SIZE=10485760
SERVER_RATE_LIMIT_PER_SECOND=10
SERVER_RATE_LIMIT_BURST=20

# PostgreSQL
DATABASE_URL=postgres://gophprofile:gophprofile@localhost:5432/gophprofile?sslmode=disable
DB_MAX_CONNS=25
DB_MIN_CONNS=5
DB_MAX_CONN_LIFETIME=1h
DB_MAX_CONN_IDLE_TIME=30m

# S3-compatible object storage (local MinIO example)
S3_ENDPOINT=localhost:9000
S3_ACCESS_KEY_ID=minioadmin
S3_SECRET_ACCESS_KEY=minioadmin
S3_BUCKET=avatars
S3_USE_SSL=false
S3_REGION=us-east-1

# Broker: rabbitmq or kafka
BROKER_TYPE=rabbitmq

# RabbitMQ
RABBITMQ_URL=amqp://gophprofile:gophprofile-dev@localhost:5672/
RABBITMQ_EXCHANGE=avatars
RABBITMQ_RETRY_DELAY=30s
RABBITMQ_MAX_ATTEMPTS=5
RABBITMQ_QUEUE_TYPE=classic

# Kafka (used when BROKER_TYPE=kafka)
KAFKA_BROKERS=localhost:9092
KAFKA_GROUP_ID=gophprofile-workers
KAFKA_MAX_ATTEMPTS=5
KAFKA_DLQ_SUFFIX=.dlq
KAFKA_SESSION_TIMEOUT=10s
KAFKA_HEARTBEAT_INTERVAL=3s
KAFKA_FETCH_MIN_BYTES=1
KAFKA_FETCH_MAX_WAIT=250ms

# Worker
WORKER_CONCURRENCY=4

# Logging
LOG_BACKEND=slog
LOG_LEVEL=debug
LOG_FORMAT=console

# OpenTelemetry
OTEL_ENABLED=false
OTEL_EXPORTER_OTLP_ENDPOINT=http://localhost:4317
OTEL_EXPORTER_OTLP_INSECURE=true
OTEL_TRACES_SAMPLER_ARG=1.0
OTEL_SERVICE_VERSION=dev
OTEL_ENVIRONMENT=development
PYROSCOPE_ENABLED=false
PYROSCOPE_SERVER_ADDRESS=http://localhost:4040
# PYROSCOPE_AUTH_TOKEN=
