FROM golang:1.26-alpine AS builder

WORKDIR /src
RUN apk add --no-cache ca-certificates git

COPY go.mod go.sum ./
RUN go mod download
COPY . .
RUN CGO_ENABLED=0 GOOS=linux go build -trimpath -ldflags='-s -w' -o /out/cronjob ./cmd/cronjob

FROM alpine:3.22
RUN apk add --no-cache ca-certificates tzdata \
    && addgroup -S app \
    && adduser -S -G app app
WORKDIR /app
COPY --from=builder --chown=app:app /out/cronjob ./cronjob
COPY --from=builder --chown=app:app /src/configs ./configs
COPY --chown=app:app deployments/docker/cronjob-scheduler.sh ./cronjob-scheduler.sh
COPY --chown=app:app deployments/docker/cronjob.crontab /etc/crontabs/app
RUN chmod 0555 /app/cronjob-scheduler.sh
USER app
ENTRYPOINT ["/app/cronjob"]
