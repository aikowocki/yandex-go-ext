FROM golang:1.26-alpine AS builder

WORKDIR /src
RUN apk add --no-cache ca-certificates git

COPY go.mod go.sum ./
RUN go mod download
COPY . .
RUN CGO_ENABLED=0 GOOS=linux go build -trimpath -ldflags='-s -w' -o /out/cronjob ./cmd/cronjob

FROM alpine:3.22
RUN apk add --no-cache ca-certificates tzdata
WORKDIR /app
COPY --from=builder /out/cronjob ./cronjob
COPY --from=builder /src/configs ./configs
COPY deployments/docker/cronjob-scheduler.sh ./cronjob-scheduler.sh
COPY deployments/docker/cronjob.crontab /etc/crontabs/root
RUN chmod +x /app/cronjob-scheduler.sh
ENTRYPOINT ["/app/cronjob"]
