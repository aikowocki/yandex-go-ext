{
  "uid": "gophprofile-pyroscope",
  "title": "GophProfile / Continuous Profiling",
  "description": "CPU, memory и goroutine профили для GophProfile.",
  "tags": ["gophprofile", "observability", "pyroscope", "profiling"],
  "timezone": "browser",
  "schemaVersion": 39,
  "version": 2,
  "refresh": "30s",
  "time": { "from": "now-1h", "to": "now" },
  "templating": {
    "list": [
      {
        "name": "service",
        "label": "Service",
        "type": "custom",
        "query": "gophprofile-server,gophprofile-worker,gophprofile-cronjob",
        "includeAll": true,
        "allValue": ".*",
        "multi": false,
        "current": { "selected": true, "text": "gophprofile-server", "value": "gophprofile-server" },
        "options": [
          { "selected": true, "text": "gophprofile-server", "value": "gophprofile-server" },
          { "selected": false, "text": "gophprofile-worker", "value": "gophprofile-worker" },
          { "selected": false, "text": "gophprofile-cronjob", "value": "gophprofile-cronjob" }
        ]
      }
    ]
  },
  "panels": [
    {
      "id": 1,
      "type": "text",
      "title": "Continuous profiling",
      "gridPos": { "h": 4, "w": 24, "x": 0, "y": 0 },
      "options": {
        "mode": "markdown",
        "content": "Выберите сервис сверху и анализируйте flame graph за выбранный диапазон времени. Профили отправляются каждые 15 секунд из Go-приложений в Pyroscope.\n\n**Подсказка:** увеличьте временной диапазон для общей картины или сузьте его до момента нагрузки для поиска конкретного узкого места."
      }
    },
    {
      "id": 2,
      "type": "row",
      "title": "CPU",
      "gridPos": { "h": 1, "w": 24, "x": 0, "y": 4 },
      "collapsed": false,
      "panels": []
    },
    {
      "id": 3,
      "type": "flamegraph",
      "title": "CPU profile",
      "gridPos": { "h": 10, "w": 24, "x": 0, "y": 5 },
      "datasource": { "type": "grafana-pyroscope-datasource", "uid": "pyroscope" },
      "targets": [
        {
          "refId": "A",
          "labelSelector": "{service_name=\"$service\"}",
          "profileTypeId": "process_cpu:cpu:nanoseconds:cpu:nanoseconds",
          "queryType": "profile",
          "groupBy": [],
          "spanSelector": []
        }
      ]
    },
    {
