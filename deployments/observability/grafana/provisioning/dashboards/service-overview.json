{
  "uid": "gophprofile-service-overview",
  "title": "GophProfile / Обзор сервиса",
  "description": "Предварительно настроенный обзор HTTP RED-метрик, пула базы данных, обмена сообщениями, бизнес-KPI аватаров и связанных логов.",
  "tags": ["gophprofile", "observability", "otel"],
  "timezone": "browser",
  "schemaVersion": 39,
  "version": 15,
  "refresh": "15s",
  "time": { "from": "now-1h", "to": "now" },
  "templating": {
    "list": [
      {
        "name": "service",
        "label": "Service",
        "type": "query",
        "datasource": { "type": "prometheus", "uid": "prometheus" },
        "query": "label_values(http_server_request_count_total, service_name)",
        "current": { "selected": true, "text": "All", "value": ".*" },
        "includeAll": true,
        "allValue": ".*",
        "multi": true,
        "refresh": 1,
        "sort": 1,
        "definition": "label_values(http_server_request_count_total, service_name)"
      },
      {
        "name": "environment",
        "label": "Environment",
        "type": "query",
        "datasource": { "type": "prometheus", "uid": "prometheus" },
        "query": "label_values(http_server_request_count_total, deployment_environment_name)",
        "current": { "selected": true, "text": "All", "value": ".*" },
        "includeAll": true,
        "allValue": ".*",
        "multi": true,
        "refresh": 1,
        "sort": 1,
        "definition": "label_values(http_server_request_count_total, deployment_environment_name)"
      }
    ]
  },
  "panels": [
    {
      "id": 1,
      "type": "timeseries",
      "title": "HTTP RPS",
      "description": "Количество завершённых HTTP-запросов в секунду.",
      "gridPos": { "h": 5, "w": 6, "x": 0, "y": 0 },
      "datasource": { "type": "prometheus", "uid": "prometheus" },
      "targets": [{ "refId": "A", "expr": "sum(rate(http_server_request_count_total{service_name=~\".*\",deployment_environment_name=~\".*\"}[5m]))" }],
      "fieldConfig": { "defaults": { "unit": "reqps", "decimals": 2, "color": { "mode": "thresholds" }, "thresholds": { "mode": "absolute", "steps": [{ "color": "green", "value": null }, { "color": "orange", "value": 50 }, { "color": "red", "value": 100 }] } }, "overrides": [] },
      "options": { "legend": { "displayMode": "table", "placement": "bottom", "calcs": ["lastNotNull"] }, "tooltip": { "mode": "multi", "sort": "desc" } }
    },
    {
      "id": 2,
      "type": "timeseries",
      "title": "Доля ошибок HTTP",
      "description": "Доля завершённых HTTP-запросов со статусом >= 500.",
      "gridPos": { "h": 5, "w": 6, "x": 6, "y": 0 },
      "datasource": { "type": "prometheus", "uid": "prometheus" },
      "targets": [{ "refId": "A", "expr": "100 * sum(rate(http_server_request_count_total{http_response_status_code=~\"5..\",service_name=~\".*\",deployment_environment_name=~\".*\"}[5m])) / clamp_min(sum(rate(http_server_request_count_total{service_name=~\".*\",deployment_environment_name=~\".*\"}[5m])), 1e-9)" }],
      "fieldConfig": { "defaults": { "unit": "percent", "decimals": 2, "thresholds": { "mode": "absolute", "steps": [{ "color": "green", "value": null }, { "color": "orange", "value": 1 }, { "color": "red", "value": 5 }] } }, "overrides": [] },
      "options": { "legend": { "displayMode": "table", "placement": "bottom", "calcs": ["lastNotNull"] }, "tooltip": { "mode": "multi", "sort": "desc" } }
    },
    {
      "type": "timeseries",
      "title": "Задержка HTTP p50 / p95 / p99",
      "description": "Процентиль длительности запросов за последние пять минут: p50 — медиана, p95 охватывает большинство запросов, а p99 показывает задержку редких медленных запросов.",
      "gridPos": { "h": 8, "w": 24, "x": 0, "y": 5 },
      "datasource": { "type": "prometheus", "uid": "prometheus" },
      "targets": [
        { "refId": "A", "legendFormat": "p50", "expr": "histogram_quantile(0.50, sum by (le) (rate(http_server_request_duration_seconds_bucket{service_name=~\".*\",deployment_environment_name=~\".*\"}[5m])))" },
        { "refId": "B", "legendFormat": "p95", "expr": "histogram_quantile(0.95, sum by (le) (rate(http_server_request_duration_seconds_bucket{service_name=~\".*\",deployment_environment_name=~\".*\"}[5m])))" },
        { "refId": "C", "legendFormat": "p99", "expr": "histogram_quantile(0.99, sum by (le) (rate(http_server_request_duration_seconds_bucket{service_name=~\".*\",deployment_environment_name=~\".*\"}[5m])))" }
      ],
      "fieldConfig": { "defaults": { "unit": "s", "min": 0 }, "overrides": [] },
      "options": { "reduceOptions": { "calcs": ["lastNotNull"], "fields": "", "values": false }, "legend": { "displayMode": "table", "placement": "bottom" }, "tooltip": { "mode": "multi" } }
    },
    {
      "type": "timeseries",
      "title": "HTTP-запросы в обработке",
      "description": "Текущее количество HTTP-запросов, находящихся в обработке приложением. Метрика отражает активную конкурентность запросов, а не накопленную очередь. Устойчивый рост значения при стабильном RPS может указывать на увеличение времени обработки, медленные обработчики или перегрузку зависимостей.",
      "gridPos": { "h": 5, "w": 6, "x": 12, "y": 0 },
      "datasource": { "type": "prometheus", "uid": "prometheus" },
      "targets": [{ "refId": "A", "expr": "sum(http_server_active_requests{service_name=~\".*\",deployment_environment_name=~\".*\"}) or vector(0)", "legendFormat": "active" }],
      "fieldConfig": { "defaults": { "unit": "short", "min": 0 }, "overrides": [] },
      "options": { "legend": { "displayMode": "table", "placement": "bottom", "calcs": ["lastNotNull"] }, "tooltip": { "mode": "multi", "sort": "desc" } }
    },
    {
      "type": "timeseries",
      "title": "Использование пула PostgreSQL",
      "description": "Ёмкость и использование пула соединений PostgreSQL: максимальное число настроенных соединений, занятые и свободные соединения.",
      "gridPos": { "h": 8, "w": 12, "x": 0, "y": 13 },
      "datasource": { "type": "prometheus", "uid": "prometheus" },
      "targets": [
        { "refId": "A", "expr": "max(db_client_connections{service_name=~\".*\",deployment_environment_name=~\".*\"})", "legendFormat": "max connections" },
        { "refId": "B", "expr": "max(db_client_connections_usage{service_name=~\".*\",deployment_environment_name=~\".*\"})", "legendFormat": "acquired" },
        { "refId": "C", "expr": "max(db_client_connections_idle{service_name=~\".*\",deployment_environment_name=~\".*\"})", "legendFormat": "idle" }
      ],
      "fieldConfig": { "defaults": { "unit": "short", "min": 0 }, "overrides": [] },
      "options": { "reduceOptions": { "calcs": ["lastNotNull"], "fields": "", "values": false }, "legend": { "displayMode": "table", "placement": "bottom" } }
    },
    {
      "type": "timeseries",
      "title": "Глубина очереди сообщений",
      "description": "Количество сообщений, обрабатываемых каждым адаптером сообщений, сгруппированное по брокеру и назначению. Это текущая обработка, а не задержка очереди брокера.",
      "gridPos": { "h": 8, "w": 12, "x": 12, "y": 13 },
      "datasource": { "type": "prometheus", "uid": "prometheus" },
      "targets": [{ "refId": "A", "expr": "sum by (messaging_system, messaging_destination_name) (messaging_queue_depth{service_name=~\".*\",deployment_environment_name=~\".*\"})", "legendFormat": "{{messaging_system}} / {{messaging_destination_name}}" }],
      "fieldConfig": { "defaults": { "unit": "short", "min": 0 }, "overrides": [] },
      "options": { "reduceOptions": { "calcs": ["lastNotNull"], "fields": "", "values": false }, "legend": { "displayMode": "table", "placement": "bottom" } }
    },
    {
      "type": "timeseries",
      "title": "Повторные попытки сообщений / DLQ",
      "description": "Частота повторных попыток обработки сообщений и отправки сообщений в очередь недоставленных сообщений. Устойчивое ненулевое значение DLQ требует расследования.",
      "gridPos": { "h": 8, "w": 24, "x": 0, "y": 21 },
      "datasource": { "type": "prometheus", "uid": "prometheus" },
      "targets": [
        { "refId": "A", "expr": "sum(rate(messaging_retry_total{service_name=~\".*\",deployment_environment_name=~\".*\"}[5m]))", "legendFormat": "retries / sec" },
        { "refId": "B", "expr": "sum(rate(messaging_dlq_total{service_name=~\".*\",deployment_environment_name=~\".*\"}[5m]))", "legendFormat": "DLQ / sec" }
      ],
      "fieldConfig": { "defaults": { "unit": "reqps", "min": 0 }, "overrides": [] },
      "options": { "reduceOptions": { "calcs": ["lastNotNull"], "fields": "", "values": false }, "legend": { "displayMode": "table", "placement": "bottom" } }
    },
    {
      "type": "timeseries",
      "title": "Транзакционный outbox",
      "description": "Количество ожидающих публикации записей транзакционного outbox. Рост показывает, что публикация событий отстаёт от записи данных в базу.",
      "gridPos": { "h": 5, "w": 6, "x": 18, "y": 0 },
      "datasource": { "type": "prometheus", "uid": "prometheus" },
      "targets": [{ "refId": "A", "expr": "max(outbox_pending{service_name=~\".*\",deployment_environment_name=~\".*\"}) or vector(0)", "legendFormat": "pending" }],
      "fieldConfig": { "defaults": { "unit": "short", "min": 0 }, "overrides": [] },
      "options": { "legend": { "displayMode": "table", "placement": "bottom", "calcs": ["lastNotNull"] }, "tooltip": { "mode": "multi", "sort": "desc" } }
    },
    {
      "type": "timeseries",
      "title": "Загрузки аватаров",
      "description": "Пропускная способность загрузки аватаров, сгруппированная по результату операции; измеряется как число завершённых загрузок в секунду.",
      "gridPos": { "h": 8, "w": 8, "x": 0, "y": 29 },
      "datasource": { "type": "prometheus", "uid": "prometheus" },
      "targets": [{ "refId": "A", "expr": "sum by (status) (rate(avatars_uploads_total{service_name=~\".*\",deployment_environment_name=~\".*\"}[5m]))", "legendFormat": "{{status}}" }],
      "fieldConfig": { "defaults": { "unit": "reqps", "min": 0 }, "overrides": [] },
      "options": { "reduceOptions": { "calcs": ["lastNotNull"], "fields": "", "values": false }, "legend": { "displayMode": "table", "placement": "bottom" } }
    },
    {
      "type": "timeseries",
      "title": "Обработка аватаров",
      "description": "Пропускная способность обработки аватаров, сгруппированная по результату операции; измеряется как число завершённых попыток обработки в секунду.",
      "gridPos": { "h": 8, "w": 8, "x": 8, "y": 29 },
      "datasource": { "type": "prometheus", "uid": "prometheus" },
      "targets": [{ "refId": "A", "expr": "sum by (status) (rate(avatars_processing_total{service_name=~\".*\",deployment_environment_name=~\".*\"}[5m]))", "legendFormat": "{{status}}" }],
      "fieldConfig": { "defaults": { "unit": "reqps", "min": 0 }, "overrides": [] },
      "options": { "reduceOptions": { "calcs": ["lastNotNull"], "fields": "", "values": false }, "legend": { "displayMode": "table", "placement": "bottom" } }
    },
    {
      "type": "timeseries",
      "title": "Использование хранилища",
      "description": "Текущий суммарный объём blob-хранилища по данным приложения, в байтах.",
      "gridPos": { "h": 8, "w": 8, "x": 16, "y": 29 },
      "datasource": { "type": "prometheus", "uid": "prometheus" },
      "targets": [{ "refId": "A", "expr": "max(storage_usage{service_name=~\".*\",deployment_environment_name=~\".*\"}) or vector(0)", "legendFormat": "blob bytes" }],
      "fieldConfig": { "defaults": { "unit": "bytes", "min": 0 }, "overrides": [] },
      "options": { "legend": { "displayMode": "table", "placement": "bottom", "calcs": ["lastNotNull"] }, "tooltip": { "mode": "multi", "sort": "desc" } }
    },
    {
      "type": "timeseries",
      "title": "Использование ресурсов хоста",
      "description": "Использование CPU и памяти хоста по данным node-exporter.",
      "gridPos": { "h": 8, "w": 12, "x": 0, "y": 45 },
      "datasource": { "type": "prometheus", "uid": "prometheus" },
      "targets": [
        { "refId": "A", "expr": "100 - (avg by (instance) (rate(node_cpu_seconds_total{job=\"node-exporter\",mode=\"idle\"}[5m])) * 100)", "legendFormat": "{{instance}} CPU used" },
        { "refId": "B", "expr": "(1 - node_memory_MemAvailable_bytes{job=\"node-exporter\"} / node_memory_MemTotal_bytes{job=\"node-exporter\"}) * 100", "legendFormat": "{{instance}} memory used" }
      ],
      "fieldConfig": { "defaults": { "unit": "short", "min": 0 }, "overrides": [{ "matcher": { "id": "byName", "options": "{{service_name}} allocated memory" }, "properties": [{ "id": "unit", "value": "bytes" }] }] },
      "options": { "reduceOptions": { "calcs": ["lastNotNull"], "fields": "", "values": false }, "legend": { "displayMode": "table", "placement": "bottom" } }
    },
    {
      "type": "timeseries",
      "title": "Длительность загрузки аватара p50 / p95 / p99",
      "description": "Перцентили длительности загрузки, сгруппированные по результату операции.",
      "gridPos": { "h": 8, "w": 8, "x": 0, "y": 37 },
      "datasource": { "type": "prometheus", "uid": "prometheus" },
      "targets": [
        { "refId": "A", "legendFormat": "{{status}} p50", "expr": "histogram_quantile(0.50, sum by (le, status) (rate(avatars_upload_duration_seconds_bucket{service_name=~\".*\",deployment_environment_name=~\".*\"}[5m])))" },
        { "refId": "B", "legendFormat": "{{status}} p95", "expr": "histogram_quantile(0.95, sum by (le, status) (rate(avatars_upload_duration_seconds_bucket{service_name=~\".*\",deployment_environment_name=~\".*\"}[5m])))" },
        { "refId": "C", "legendFormat": "{{status}} p99", "expr": "histogram_quantile(0.99, sum by (le, status) (rate(avatars_upload_duration_seconds_bucket{service_name=~\".*\",deployment_environment_name=~\".*\"}[5m])))" }
      ],
      "fieldConfig": { "defaults": { "unit": "s", "min": 0 }, "overrides": [] },
      "options": { "legend": { "displayMode": "table", "placement": "bottom" }, "tooltip": { "mode": "multi" } }
    },
    {
      "type": "timeseries",
      "title": "Длительность обработки аватара p50 / p95 / p99",
      "description": "Процентиль длительности обработки worker, сгруппированные по результату операции.",
      "gridPos": { "h": 8, "w": 8, "x": 8, "y": 37 },
      "datasource": { "type": "prometheus", "uid": "prometheus" },
      "targets": [
        { "refId": "A", "legendFormat": "{{status}} p50", "expr": "histogram_quantile(0.50, sum by (le, status) (rate(avatars_processing_duration_seconds_bucket{service_name=~\".*\",deployment_environment_name=~\".*\"}[5m])))" },
        { "refId": "B", "legendFormat": "{{status}} p95", "expr": "histogram_quantile(0.95, sum by (le, status) (rate(avatars_processing_duration_seconds_bucket{service_name=~\".*\",deployment_environment_name=~\".*\"}[5m])))" },
        { "refId": "C", "legendFormat": "{{status}} p99", "expr": "histogram_quantile(0.99, sum by (le, status) (rate(avatars_processing_duration_seconds_bucket{service_name=~\".*\",deployment_environment_name=~\".*\"}[5m])))" }
      ],
      "fieldConfig": { "defaults": { "unit": "s", "min": 0 }, "overrides": [] },
      "options": { "legend": { "displayMode": "table", "placement": "bottom" }, "tooltip": { "mode": "multi" } }
    },
    {
      "type": "timeseries",
      "title": "p95 длительности сообщений",
      "description": "p95 длительности публикации и обработки сообщений, сгруппированный по системе сообщений, назначению и результату операции.",
      "gridPos": { "h": 8, "w": 8, "x": 16, "y": 37 },
      "datasource": { "type": "prometheus", "uid": "prometheus" },
      "targets": [
        { "refId": "A", "legendFormat": "publish {{messaging_system}}/{{messaging_destination_name}} {{status}}", "expr": "histogram_quantile(0.95, sum by (le, messaging_system, messaging_destination_name, status) (rate(messaging_publish_duration_seconds_bucket{service_name=~\".*\",deployment_environment_name=~\".*\"}[5m])))" },
        { "refId": "B", "legendFormat": "consume {{messaging_system}}/{{messaging_destination_name}} {{status}}", "expr": "histogram_quantile(0.95, sum by (le, messaging_system, messaging_destination_name, status) (rate(messaging_consume_duration_seconds_bucket{service_name=~\".*\",deployment_environment_name=~\".*\"}[5m])))" }
      ],
      "fieldConfig": { "defaults": { "unit": "s", "min": 0 }, "overrides": [] },
      "options": { "legend": { "displayMode": "table", "placement": "bottom" }, "tooltip": { "mode": "multi" } }
    },
    {
      "id": 13,
      "type": "stat",
      "title": "Состояние цели метрик приложения",
      "description": "Состояние Prometheus-цели, через которую OpenTelemetry Collector предоставляет метрики приложения. Значение 1 означает, что цель доступна.",
      "gridPos": { "h": 8, "w": 6, "x": 12, "y": 45 },
      "datasource": { "type": "prometheus", "uid": "prometheus" },
      "targets": [{ "refId": "A", "expr": "sum(up{job=\"otel-collector\"})" }],
      "fieldConfig": { "defaults": { "unit": "short", "min": 0, "thresholds": { "mode": "absolute", "steps": [{ "color": "red", "value": null }, { "color": "green", "value": 1 }] } }, "overrides": [] },
      "options": { "reduceOptions": { "calcs": ["lastNotNull"], "fields": "", "values": false }, "colorMode": "value" }
    },
    {
      "id": 14,
      "type": "logs",
      "title": "Связанные логи приложения",
      "description": "Поиск структурированных метаданных Loki с сохранением trace_id для настроенной ссылки из логов в трейсы.",
      "gridPos": { "h": 12, "w": 6, "x": 18, "y": 45 },
      "datasource": { "type": "loki", "uid": "loki" },
      "targets": [{ "refId": "A", "expr": "{service_name=~\".+\"} | json | trace_id != \"\"", "queryType": "range" }],
      "options": { "showTime": true, "showLabels": true, "showCommonLabels": false, "wrapLines": true, "prettifyLogMessage": false, "enableLogDetails": true, "sortOrder": "Descending", "deduplication": "none" }
    }
  ],
  "annotations": { "list": [] },
  "links": [
    {
      "title": "Зависимости сервиса в Jaeger",
      "type": "link",
      "url": "http://localhost:16686/dependencies",
      "targetBlank": true,
      "icon": "external link"
    }
  ]
}
